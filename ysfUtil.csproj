<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- Oberflaeche in WPF, das Symbol im Infobereich ueber NotifyIcon aus WinForms -
         dasselbe Muster wie in Audio Mirror. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>

    <!-- Kein App.xaml: Program.Main bleibt der Einstiegspunkt, weil dort die Instanzsperre
         und der stille Start haengen. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ysfUtil</AssemblyName>
    <RootNamespace>YsfUtil</RootNamespace>
    <ApplicationIcon>ysfUtil.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Leichtgewichtig: nicht self-contained. Die .NET 8 Desktop Runtime muss installiert
         sein, dafuer bleibt die exe unter einem Megabyte statt ueber 70. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>0.1.0</Version>
    <Company>Yusuf Esad Mumcu</Company>
    <Copyright>Copyright (c) 2026 Yusuf Esad Mumcu</Copyright>
    <Product>ysfUtil</Product>
    <AssemblyTitle>ysfUtil</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms und WPF benennen vieles gleich (Application, Brush, Color, ...). Wo WinForms
         gebraucht wird, steht es ausdruecklich im Kopf der Datei. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dasselbe Symbol wie die exe, zusaetzlich als WPF-Ressource fuer die Titelleiste. -->
    <Resource Include="ysfUtil.ico" />
  </ItemGroup>

</Project>
