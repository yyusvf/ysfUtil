<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- UI in WPF, tray icon via the WinForms NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>

    <!-- No App.xaml: Program.Main stays the entry point (single instance, quiet start). -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ysfUtil</AssemblyName>
    <RootNamespace>YsfUtil</RootNamespace>
    <ApplicationIcon>ysfUtil.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Lightweight: framework-dependent. Needs the .NET 8 Desktop Runtime, but the exe stays
         under a megabyte instead of 70+. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>0.1.0</Version>
    <Company>Yusuf Esad Mumcu</Company>
    <Copyright>Copyright (c) 2026 Yusuf Esad Mumcu</Copyright>
    <Product>ysfUtil</Product>
    <AssemblyTitle>ysfUtil</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF share many type names (Application, Brush, Color, ...). Files that
         need WinForms import it explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same icon as the exe, also as a WPF resource for the flyout header. -->
    <Resource Include="ysfUtil.ico" />
  </ItemGroup>

</Project>
