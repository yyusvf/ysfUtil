<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What a ysfUtil plugin builds against: the module contract, hotkey features and the shared
    controls. ysfUtil ships this assembly; a plugin references it without copying it
    (Private=false), so both use the same types at runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YsfUtil.Sdk</AssemblyName>
    <RootNamespace>YsfUtil</RootNamespace>
    <!-- Major version = PluginApi.Version. Raise it only for breaking changes. -->
    <Version>1.0.0</Version>
    <!-- Fixed, so plugins bind to it whatever version a build passes around. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="ysfUtil" />
  </ItemGroup>

</Project>
