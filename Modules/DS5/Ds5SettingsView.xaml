<UserControl x:Class="YsfUtil.Modules.DS5.Ds5SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
        <Expander Style="{StaticResource FeatureExpander}" views:SectionState.Key="ds5-settings"
                  AutomationProperties.Name="DS5 BT Haptics settings">
            <Expander.Header>
                <TextBlock Text="DS5 BT Haptics" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Haptics strength" Style="{StaticResource SecondaryText}" />
                    <TextBlock Grid.Column="1" Text="{Binding GainText}" Style="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <Slider Value="{Binding Gain, Mode=TwoWay}" Minimum="0.25" Maximum="4" SmallChange="0.05" LargeChange="0.25"
                        Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Haptics strength"
                        ToolTip="Applies immediately, also during a game." />

                <CheckBox Content="Lower latency" IsChecked="{Binding LowLatency, Mode=TwoWay}" Style="{StaticResource LabeledCheckBox}"
                          Margin="0,12,0,0" ToolTip="Sends haptics every 10.7 ms instead of 21.3 ms, at twice the Bluetooth traffic." />
                <CheckBox Content="Report the real controller address" IsChecked="{Binding RealMac, Mode=TwoWay}"
                          Style="{StaticResource LabeledCheckBox}" Margin="0,6,0,0"
                          ToolTip="Some tools need it. Drops the Bluetooth link while Steam runs. Restarts the bridge." />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />
                <TextBlock Text="Games with their own Bluetooth haptics" Style="{StaticResource BodyText}" />
                <TextBlock Text="While one runs, the bridge pauses and the game talks to the controller directly."
                           Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,6" />
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4" ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource GlyphButton}" Command="{Binding RemoveCommand}"
                                        ToolTip="Remove" AutomationProperties.Name="Remove game" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add game …" Style="{StaticResource StandardButton}" Command="{Binding AddGameCommand}" Margin="0,4,0,0" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="Restart bridge" Style="{StaticResource StandardButton}" Command="{Binding RestartCommand}" />
                    <Button Grid.Column="2" Content="Open log" Style="{StaticResource StandardButton}" Command="{Binding OpenLogCommand}" />
                </Grid>
                <Button Content="Make controller visible to games" Style="{StaticResource StandardButton}" Margin="0,6,0,0"
                        Command="{Binding UndoHidHideCommand}" IsEnabled="{Binding IsIdle}"
                        ToolTip="Undoes the HidHide setup, e.g. before turning this module off for good. Asks for admin rights." />
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
