<UserControl x:Class="YsfUtil.Modules.AudioMirror.AudioMirrorFlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen" /></UserControl.Resources>
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,6">
        <Expander Style="{StaticResource FeatureExpander}" views:SectionState.Key="audio-mirror"
                  AutomationProperties.Name="Audio Mirror options">
            <Expander.Header>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Audio Mirror" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" TextTrimming="None">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding ToggleGlyph}" Style="{StaticResource GlyphButton}"
                        ToolTip="{Binding ToggleTip}" AutomationProperties.Name="Toggle mirroring" Command="{Binding ToggleCommand}" />
            </Grid>
            </Expander.Header>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock x:Name="DeviceGlyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                              AutomationProperties.Name="{Binding DisplayName}" />
                                </Grid>
                                <Grid Margin="30,4,0,0" Visibility="{Binding ShowsVolume, Converter={StaticResource VisibleWhen}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <Slider Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VolumeSlider}"
                                            AutomationProperties.Name="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource SecondaryText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter TargetName="DeviceGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:HotkeyBox HorizontalAlignment="Stretch" Margin="0,2,0,0" Hotkey="{Binding ToggleFeature.Hotkey, Mode=TwoWay}"
                                 HasError="{Binding ToggleFeature.HasHotkeyError}" AutomationProperties.Name="Toggle mirroring hotkey"
                                 ToolTip="Turns all mirroring off and restores it on the next press. Esc removes the hotkey." />
                <TextBlock Text="{Binding ToggleFeature.HotkeyError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="{Binding ToggleFeature.HasHotkeyError, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
