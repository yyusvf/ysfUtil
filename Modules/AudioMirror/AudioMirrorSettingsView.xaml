<UserControl x:Class="YsfUtil.Modules.AudioMirror.AudioMirrorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen" /></UserControl.Resources>
    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
        <Expander Style="{StaticResource FeatureExpander}" views:SectionState.Key="audio-mirror-settings"
                  AutomationProperties.Name="Audio Mirror settings">
            <Expander.Header>
                <TextBlock Text="Audio Mirror" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel>
                <TextBlock Text="Source" Style="{StaticResource SecondaryText}" Margin="0,0,0,5" />
                <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}" AutomationProperties.Name="Source device"
                          ToolTip="The device whose sound is mirrored. It is never a target itself." />

                <Grid Margin="0,14,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Buffer" Style="{StaticResource SecondaryText}" />
                    <TextBlock Grid.Column="1" Text="{Binding BufferText}" Style="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <Slider Value="{Binding BufferMs, Mode=TwoWay}" Minimum="10" Maximum="250" SmallChange="5" LargeChange="10"
                        Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Buffer"
                        ToolTip="Smaller means less latency, larger means more headroom against dropouts. Default is 30 ms; increase it if you hear crackling." />

                <!-- Per device: which apps are mirrored and how loud. All on at full volume captures the whole device. -->
                <ItemsControl ItemsSource="{Binding Devices}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowsVolume}" Value="True" />
                                                    <Condition Binding="{Binding HasApps}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                <TextBlock Text="Apps mirrored to this device" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,6" />
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Style="{StaticResource LabeledCheckBox}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource SecondaryText}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <Slider Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VolumeSlider}"
                                                        IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding DisplayName}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"
                                                           Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
