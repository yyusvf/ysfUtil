<UserControl x:Class="YsfUtil.Modules.Tools.ToolsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
        <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Tools" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,12" />
                <ItemsControl x:Name="SettingsFeatureList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid x:Name="VolumeSetting" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Volume controls" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Volume controls" />
                </Grid>
                <Grid x:Name="ShutdownSetting">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shutdown timer" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Shutdown timer" />
                </Grid>
            </StackPanel>
        </Border>
</UserControl>
