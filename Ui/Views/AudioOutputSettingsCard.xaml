<UserControl x:Class="YsfUtil.Ui.Views.AudioOutputSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen" /></UserControl.Resources>
    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
        <Expander x:Name="Options" Style="{StaticResource FeatureExpander}" views:SectionState.Key="audio-settings"
                  AutomationProperties.Name="Audio output settings">
            <Expander.Header>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Audio output" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource GlyphButton}" Command="{Binding RefreshCommand}"
                        ToolTip="Refresh output devices" AutomationProperties.Name="Refresh output devices" />
            </Grid>
            </Expander.Header>
            <StackPanel>
            <TextBlock Text="Choose the outputs your hotkey cycles through." Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="DeviceRow" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,0,4" Padding="8,10"
                                Background="{DynamicResource ControlDisabledBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Included, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name}" ToolTip="Include in hotkey cycle" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="DeviceRow" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding CycleSummary}" Style="{StaticResource SecondaryText}" Margin="0,6,0,12" />
            <CheckBox Content="Also switch communication audio" IsChecked="{Binding SwitchCommunications}" Style="{StaticResource LabeledCheckBox}" Margin="0,0,0,12" />
            <CheckBox Content="Show a banner when switching" IsChecked="{Binding ShowBanner}" Style="{StaticResource LabeledCheckBox}" Margin="0,0,0,12" />
            <Button Content="Import SoundSwitch devices" Style="{StaticResource StandardButton}" Command="{Binding ImportCommand}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        </Expander>
    </Border>
</UserControl>
