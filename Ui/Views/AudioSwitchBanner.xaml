<Window x:Class="YsfUtil.Ui.Views.AudioSwitchBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="80" SizeToContent="Manual" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False" IsHitTestVisible="False">
    <Grid>
        <Border x:Name="Backdrop" Background="Black" BorderBrush="{DynamicResource StrokeStrongBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Opacity="0.59" />
        <Grid Margin="13,11">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="IconTile" Width="36" Height="36" Margin="0,9,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource CardBrush}" CornerRadius="{StaticResource RadiusControl}">
                <Grid>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusControl}" />
                <TextBlock x:Name="DeviceGlyph" FontFamily="{StaticResource IconFont}" FontSize="18" Text="&#xE995;"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="BannerTitle" Text="Audio output" Style="{StaticResource SecondaryText}" Foreground="#D0D0D0" Height="16" />
                <TextBlock x:Name="DeviceName" Style="{StaticResource BodyText}" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0"
                           Height="36" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                           VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
