<UserControl x:Class="YsfUtil.Ui.Views.AudioOutputCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen" /></UserControl.Resources>
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,6">
        <Expander Style="{StaticResource FeatureExpander}" views:SectionState.Key="audio-output"
                  AutomationProperties.Name="Audio output options">
            <Expander.Header>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <!-- Same device-tile language as Audio Mirror. -->
                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding CurrentGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Audio output" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CycleSummary}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE713;" Style="{StaticResource GlyphButton}"
                        ToolTip="Choose outputs for the hotkey cycle" AutomationProperties.Name="Audio output settings" Click="OnSettings" />
            </Grid>
            </Expander.Header>
            <StackPanel>
            <ComboBox ItemsSource="{Binding AvailableOutputs}" SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                      Style="{StaticResource ThemedComboBox}" IsEnabled="{Binding CanSwitch}"
                      ToolTip="{Binding CurrentName}" AutomationProperties.Name="Current audio output">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="No output device connected" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasOutputs}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <views:HotkeyBox HorizontalAlignment="Stretch" Hotkey="{Binding Feature.Hotkey, Mode=TwoWay}"
                                 HasError="{Binding Feature.HasHotkeyError}" AutomationProperties.Name="Cycle audio output hotkey" />
                <Button Grid.Column="1" Content="Next" Style="{StaticResource StandardButton}" Margin="6,0,0,0"
                        Command="{Binding NextCommand}" IsEnabled="{Binding CanSwitch}" ToolTip="Switch to the next selected output" />
            </Grid>
            <TextBlock Text="{Binding Feature.HotkeyError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Feature.HasHotkeyError, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        </Expander>
    </Border>
</UserControl>
