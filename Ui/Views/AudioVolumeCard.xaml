<UserControl x:Class="YsfUtil.Ui.Views.AudioVolumeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YsfUtil.Ui.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen" /></UserControl.Resources>
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,6">
        <Expander Style="{StaticResource FeatureExpander}" views:SectionState.Key="volume"
                  AutomationProperties.Name="Volume options">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Volume controls" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </StackPanel>
            </Expander.Header>
            <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Output volume" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding OutputText}" Style="{StaticResource BodyText}" Typography.NumeralAlignment="Tabular" />
            </Grid>
            <TextBlock Text="{Binding OutputName}" Style="{StaticResource SecondaryText}" ToolTip="{Binding OutputName}" Margin="0,0,0,4" />
            <Slider Value="{Binding OutputVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VolumeSlider}"
                    IsEnabled="{Binding HasOutput}" AutomationProperties.Name="Windows output volume" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,12" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Microphone volume" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding InputText}" Style="{StaticResource BodyText}" Typography.NumeralAlignment="Tabular" />
            </Grid>
            <TextBlock Text="{Binding InputName}" Style="{StaticResource SecondaryText}" ToolTip="{Binding InputName}" Margin="0,0,0,4" />
            <Slider Value="{Binding InputVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VolumeSlider}"
                    IsEnabled="{Binding HasInput}" AutomationProperties.Name="Windows microphone volume" />
            <CheckBox Content="{Binding LockLabel}" IsChecked="{Binding LockMicrophone, Mode=TwoWay}" IsEnabled="{Binding HasInput}"
                      Style="{StaticResource LabeledCheckBox}" Margin="0,10,0,0"
                      ToolTip="Restore this level when another app changes it, including while ysfUtil is minimized." />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        </Expander>
    </Border>
</UserControl>
