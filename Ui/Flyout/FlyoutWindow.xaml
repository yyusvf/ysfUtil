<Window x:Class="YsfUtil.Ui.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ysfUtil"
        Width="360"
        MinWidth="360" MaxWidth="360"
        MinHeight="72" MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <!--
        A flyout like the Windows 11 volume or Wi-Fi panel: no title bar, next to the tray,
        gone when clicking elsewhere.

        Deliberately a normal framed window with CaptionHeight 0 instead of WindowStyle="None":
        only a framed window gets shadow and rounded corners from the window manager. WindowChrome
        makes the frame invisible, and without a resize border it cannot be dragged.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══ Header ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Height="40" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource GlyphButton}"
                        Margin="-4,0,4,0"
                        Content="&#xE72B;"
                        ToolTip="Back"
                        Visibility="Collapsed"
                        Click="OnBack" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="Logo"
                           Width="18" Height="18"
                           Margin="4,0,10,0"
                           VerticalAlignment="Center">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/ysfUtil.ico" DecodePixelWidth="36" />
                        </Image.Source>
                    </Image>
                    <TextBlock x:Name="HeaderText"
                               Text="ysfUtil"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Button x:Name="SettingsButton"
                        Grid.Column="3"
                        Style="{StaticResource GlyphButton}"
                        Content="&#xE713;"
                        ToolTip="Settings"
                        Click="OnSettings" />
                <Ellipse x:Name="UpdateIndicator" Grid.Column="3" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,3,2,0" Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                    <Ellipse.Visibility>
                        <Binding Path="DataContext.Updater.HasUpdate" ElementName="SettingsView"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                    </Ellipse.Visibility>
                </Ellipse>
                <Button x:Name="MinimizeButton"
                        Grid.Column="4"
                        Style="{StaticResource GlyphButton}"
                        Margin="6,0,0,0"
                        Content="&#xE921;"
                        ToolTip="Minimize to tray"
                        AutomationProperties.Name="Minimize to tray"
                        Click="OnMinimize" />
            </Grid>

            <!-- ══ Features ════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="FeaturesView" Grid.Row="1" Style="{StaticResource ThemedScrollViewer}">
                    <StackPanel>
                        <Border x:Name="EmptyFeatures" Visibility="Collapsed" Height="120" Padding="12"
                                Background="{DynamicResource CardBrush}" CornerRadius="{StaticResource RadiusCard}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nothing enabled" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="Enable a module or feature in Settings to get started." Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Each running module adds its cards here, in catalog order. -->
                        <StackPanel x:Name="ModuleViews" />
                    </StackPanel>
            </ScrollViewer>

            <!-- ══ Settings ════════════════════════════════════════════════════ -->
            <!-- Canvas does not contribute to the desired window size: only the main view does. -->
            <Canvas Grid.Row="1">
            <Grid x:Name="SettingsView" Visibility="Collapsed"
                  Width="{Binding ActualWidth, ElementName=FeaturesView}"
                  Height="{Binding ActualHeight, ElementName=FeaturesView}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" Style="{StaticResource ThemedScrollViewer}">
                <StackPanel>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource LabeledCheckBox}"
                                  Content="Start with Windows"
                                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="Appearance"
                                   Margin="0,14,0,5" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="Notification position" Margin="0,14,0,5" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding NotificationPositions}"
                                  SelectedIndex="{Binding NotificationPositionIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Notification position" />
                        <Button Content="Preview notification" Style="{StaticResource StandardButton}"
                                Command="{Binding PreviewNotificationCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0" DataContext="{Binding Updater}">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Modes}"
                                  SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" AutomationProperties.Name="Update behavior" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   TextTrimming="None" Margin="0,10,0,10" />
                        <Button Content="Check for updates" Style="{StaticResource StandardButton}"
                                Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" />
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="HasUpdate"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                            </StackPanel.Visibility>
                            <Button Content="{Binding InstallLabel}" Style="{StaticResource StandardButton}" Margin="0,6,0,0"
                                    Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                            <Button Content="Release notes" Style="{StaticResource StandardButton}" Margin="0,6,0,0"
                                    Command="{Binding ReleaseCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Like Windhawk: every module can be switched on and off; a disabled one is never loaded. -->
                <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Modules" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl x:Name="ModuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14" ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                       TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"
                                                  AutomationProperties.Name="{Binding Name}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ModuleSettingsViews" />
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="2,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource SecondaryText}"
                               Text="{Binding Version}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource GlyphButton}"
                            Content="&#xE8B7;"
                            ToolTip="Open settings folder"
                            Command="{Binding OpenSettingsFolderCommand}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource StandardButton}"
                            Margin="8,0,0,0"
                            Content="Quit"
                            Click="OnExit" />
                </Grid>
            </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
