<Window x:Class="YsfUtil.Ui.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YsfUtil.Ui.ViewModels"
        xmlns:views="clr-namespace:YsfUtil.Ui.Views"
        Title="ysfUtil"
        Width="360"
        MinWidth="360" MaxWidth="360"
        MinHeight="72" MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <!--
        A flyout like the Windows 11 volume or Wi-Fi panel: no title bar, next to the tray,
        gone when clicking elsewhere.

        Deliberately a normal framed window with CaptionHeight 0 instead of WindowStyle="None":
        only a framed window gets shadow and rounded corners from the window manager. WindowChrome
        makes the frame invisible, and without a resize border it cannot be dragged.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ══ Feature card ════════════════════════════════════════════════════
             Top: glyph, name over status. Below: full-width hotkey box and the
             run-now button. -->
        <DataTemplate DataType="{x:Type vm:FeatureViewModel}">
            <Border Margin="0,0,0,6"
                    Padding="12"
                    CornerRadius="{StaticResource RadiusCard}"
                    Background="{DynamicResource CardBrush}"
                    ToolTip="{Binding Description}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAudioOutput}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Expander Style="{StaticResource FeatureExpander}" views:SectionState.Key="{Binding Feature.Id}"
                          AutomationProperties.Name="{Binding Name}">
                <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="GlyphTile"
                            Grid.Row="0" Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="GlyphText"
                                   Text="{Binding Glyph}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource SecondaryText}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   TextTrimming="None"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusLine}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GlyphButton}" Content="&#xE768;"
                            ToolTip="Run now" AutomationProperties.Name="{Binding Name}" Command="{Binding RunCommand}"
                            IsEnabled="{Binding IsEnabled}" />
                </Grid>
                </Expander.Header>
                        <views:HotkeyBox
                                         HorizontalAlignment="Stretch"
                                         Hotkey="{Binding Hotkey, Mode=TwoWay}"
                                         HasError="{Binding HasHotkeyError}"
                                         IsEnabled="{Binding IsEnabled}"
                                         ToolTip="Click and press a key combination. Esc removes the hotkey." />

                </Expander>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="GlyphTile" Property="Background" Value="{DynamicResource ControlBrush}" />
                    <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasHotkeyError}" Value="True">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══ Header ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Height="40" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource GlyphButton}"
                        Margin="-4,0,4,0"
                        Content="&#xE72B;"
                        ToolTip="Back"
                        Visibility="Collapsed"
                        Click="OnBack" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="Logo"
                           Width="18" Height="18"
                           Margin="4,0,10,0"
                           VerticalAlignment="Center">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/ysfUtil.ico" DecodePixelWidth="36" />
                        </Image.Source>
                    </Image>
                    <TextBlock x:Name="HeaderText"
                               Text="ysfUtil"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Button x:Name="SettingsButton"
                        Grid.Column="3"
                        Style="{StaticResource GlyphButton}"
                        Content="&#xE713;"
                        ToolTip="Settings"
                        Click="OnSettings" />
                <Ellipse x:Name="UpdateIndicator" Grid.Column="3" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,3,2,0" Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                    <Ellipse.Visibility>
                        <Binding Path="DataContext.Updater.HasUpdate" ElementName="SettingsView"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                    </Ellipse.Visibility>
                </Ellipse>
                <Button x:Name="MinimizeButton"
                        Grid.Column="4"
                        Style="{StaticResource GlyphButton}"
                        Margin="6,0,0,0"
                        Content="&#xE921;"
                        ToolTip="Minimize to tray"
                        AutomationProperties.Name="Minimize to tray"
                        Click="OnMinimize" />
            </Grid>

            <!-- ══ Features ════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="FeaturesView" Grid.Row="1" Style="{StaticResource ThemedScrollViewer}">
                    <StackPanel>
                        <Border x:Name="EmptyFeatures" Visibility="Collapsed" Height="120" Padding="12"
                                Background="{DynamicResource CardBrush}" CornerRadius="{StaticResource RadiusCard}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="No features enabled" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="Enable a feature in Settings to get started." Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <views:AudioOutputCard x:Name="AudioCard">
                            <views:AudioOutputCard.Visibility>
                                <Binding Path="Feature.IsEnabled"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                            </views:AudioOutputCard.Visibility>
                        </views:AudioOutputCard>
                        <views:AudioVolumeCard x:Name="VolumeCard">
                            <views:AudioVolumeCard.Visibility>
                                <Binding Path="IsEnabled"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                            </views:AudioVolumeCard.Visibility>
                        </views:AudioVolumeCard>
                        <ItemsControl x:Name="FeatureList" />
                        <views:ShutdownTimerCard x:Name="ShutdownCard">
                            <views:ShutdownTimerCard.Visibility>
                                <Binding Path="IsEnabled"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                            </views:ShutdownTimerCard.Visibility>
                        </views:ShutdownTimerCard>
                    </StackPanel>
            </ScrollViewer>

            <!-- ══ Settings ════════════════════════════════════════════════════ -->
            <!-- Canvas does not contribute to the desired window size: only the main view does. -->
            <Canvas Grid.Row="1">
            <Grid x:Name="SettingsView" Visibility="Collapsed"
                  Width="{Binding ActualWidth, ElementName=FeaturesView}"
                  Height="{Binding ActualHeight, ElementName=FeaturesView}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" Style="{StaticResource ThemedScrollViewer}">
                <StackPanel>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource LabeledCheckBox}"
                                  Content="Start with Windows"
                                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="Appearance"
                                   Margin="0,14,0,5" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0" DataContext="{Binding Updater}">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Modes}"
                                  SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" AutomationProperties.Name="Update behavior" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   TextTrimming="None" Margin="0,10,0,10" />
                        <Button Content="Check for updates" Style="{StaticResource StandardButton}"
                                Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" />
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="HasUpdate"><Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter></Binding>
                            </StackPanel.Visibility>
                            <Button Content="{Binding InstallLabel}" Style="{StaticResource StandardButton}" Margin="0,6,0,0"
                                    Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                            <Button Content="Release notes" Style="{StaticResource StandardButton}" Margin="0,6,0,0"
                                    Command="{Binding ReleaseCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Features" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl x:Name="SettingsFeatureList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid x:Name="VolumeSetting" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Volume controls" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Volume controls" />
                        </Grid>
                        <Grid x:Name="ShutdownSetting">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shutdown timer" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Shutdown timer" />
                        </Grid>
                    </StackPanel>
                </Border>
                <views:AudioOutputSettingsCard x:Name="AudioSettingsCard" />
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="2,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource SecondaryText}"
                               Text="{Binding Version}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource GlyphButton}"
                            Content="&#xE8B7;"
                            ToolTip="Open settings folder"
                            Command="{Binding OpenSettingsFolderCommand}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource StandardButton}"
                            Margin="8,0,0,0"
                            Content="Quit"
                            Click="OnExit" />
                </Grid>
            </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
